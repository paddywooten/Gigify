# --- Database ---
# SQLite for local development. For production use Postgres, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/gigify"
DATABASE_URL="file:./dev.db"

# --- Payments ---
# "mock" simulates card charges/payouts locally (no real money moves).
# "stripe" is a stub: implement StripePaymentProvider before switching.
PAYMENT_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."

# --- App ---
APP_URL="http://localhost:3000"
