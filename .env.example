# --- Database ---
# SQLite for local development. For production use Postgres, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/gigify"
DATABASE_URL="file:./dev.db"

# --- Payments ---
# "mock" (default) simulates charges/payouts locally — no real money moves.
# "stripe"    real escrow via Stripe test mode  (needs STRIPE_SECRET_KEY)
# "paystack"  real escrow via Paystack test mode (needs PAYSTACK_SECRET_KEY)
PAYMENT_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."      # from `stripe listen` or the dashboard
# STRIPE_DEFAULT_DESTINATION="acct_..."  # test fallback before Connect onboarding
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."      # public key handed to the Inline popup
# PAYSTACK_WEBHOOK_SECRET="..."          # "Secret Hash" from the Paystack dashboard
# PAYSTACK_DEFAULT_RECIPIENT="RCP_..."   # test fallback transfer recipient
# PLATFORM_CURRENCY="ghs"                # platform currency (defaults to GHS)

# --- App ---
APP_URL="http://localhost:3000"

# --- Google sign-in ---
# OAuth client from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/v1/auth/google/callback
# (Without these, the "Continue with Google" button explains itself in-app.)
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# GOOGLE_REDIRECT_URI="https://your-domain/api/v1/auth/google/callback"

# --- Email ---
# "console" (default) writes every email to logs/outbox/emails.jsonl (JSONL).
# "resend" sends via https://resend.com when RESEND_API_KEY is set.
# "off" disables email entirely.
EMAIL_PROVIDER="console"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Gigify <onboarding@resend.dev>"
# EMAIL_OUTBOX_PATH="logs/outbox/emails.jsonl"

# --- Media storage ---
# "local" (default) stores musician portfolio files under UPLOAD_DIR.
MEDIA_STORAGE="local"
# UPLOAD_DIR="uploads"
